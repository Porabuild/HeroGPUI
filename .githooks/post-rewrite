#!/bin/sh
# HeroGPUI: keep the gitignored `.vendor/` GPUI forks in step after a rewrite.
#
# Runs once at the end of `git rebase` and after `git commit --amend`, which is
# how a checkout lands on patches it has never materialized without any
# post-checkout or post-merge firing.
#
# Git streams "<old-sha> <new-sha>" lines on stdin. Drain them: nothing here
# needs them, and a hook that exits with the pipe still full makes git's writer
# take a needless EPIPE.
cat >/dev/null 2>&1
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/.shots/materialize.sh" ] || exit 0
exec sh "$root/.shots/materialize.sh" --soft
