#!/bin/sh
# HeroGPUI: keep the gitignored `.vendor/` GPUI forks in step after a merge.
#
# This is the `git pull` path as well as `git merge`; git passes a squash flag
# that does not change what has to happen, so it is ignored. `--soft` means a
# failure here warns and exits 0: a merge is already committed by the time this
# runs, and wedging it would leave a worse mess than a stale `.vendor/`.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/.shots/materialize.sh" ] || exit 0
exec sh "$root/.shots/materialize.sh" --soft
