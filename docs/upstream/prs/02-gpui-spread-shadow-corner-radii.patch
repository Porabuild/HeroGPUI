+
+    struct SpreadShadowView;
+
+    impl Render for SpreadShadowView {
+        fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .p(px(20.))
+                .child(div().size(px(40.)).rounded(px(8.)).shadow(vec![
+                    crate::BoxShadow {
+                        color: crate::black(),
+                        offset: point(px(0.), px(0.)),
+                        blur_radius: px(0.),
+                        spread_radius: px(4.),
+                        inset: false,
+                    },
+                    crate::BoxShadow {
+                        color: crate::black(),
+                        offset: point(px(0.), px(0.)),
+                        blur_radius: px(0.),
+                        spread_radius: px(-12.),
+                        inset: false,
+                    },
+                ]))
+        }
+    }
+
+    #[gpui::test]
+    fn test_spread_shadow_corner_radii_follow_the_spread(cx: &mut TestAppContext) {
+        let (_, cx) = cx.add_window_view(|_, _| SpreadShadowView);
+        cx.run_until_parked();
+        cx.update(|window, _| {
+            let scale_factor = window.scale_factor();
+            let mut radii = window
+                .painted_shadows()
+                .iter()
+                .map(|shadow| shadow.corner_radii.top_left.0 / scale_factor)
+                .collect::<Vec<_>>();
+            radii.sort_by(f32::total_cmp);
+            // A negative spread larger than the 8px radius clamps at zero; a
+            // 4px spread grows it to 12px.
+            assert_eq!(radii, vec![0., 12.]);
+        });
+    }
