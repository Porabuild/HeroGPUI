# Keep the working tree's line endings stable so `cargo fmt` never produces a
# whole-file diff. rustfmt.toml pins `newline_style = "Unix"`; this makes git
# check the same files out that way.
* text=auto
.gitattributes text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
# The git hooks have no extension, so `* text=auto` above would check them out
# with the platform's native endings -- CRLF on Windows, where Git Bash then
# refuses the `#!/bin/sh\r` shebang and git reports the hook as failing. They
# also need the executable bit in the index (mode 100755); git silently ignores
# a hook it cannot execute.
.githooks/* text eol=lf
# The GPUI fork patches are a build input now, not just an audit artifact:
# `.shots/gpui_patches.py --materialize` applies them before every cargo
# command on all three CI hosts. `* text=auto` above would hand the Windows
# runner CRLF copies, so pin them the way every other source file is pinned.
*.patch text eol=lf
# Oxfmt checks LF endings, including on Windows checkouts.
web/**/*.ts text eol=lf
web/**/*.tsx text eol=lf
web/**/*.mjs text eol=lf
web/**/*.json text eol=lf
web/**/*.css text eol=lf
# Hash-pinned files: checked out byte-identical so SHA-256 pins match on
# every OS. `* text=auto` would convert these to CRLF on Windows.
web/public/gallery/*.js -text
web/public/gallery/*.wasm binary
web/public/gallery/index.html text eol=lf
# PowerShell is happier with CRLF on Windows.
*.ps1 text eol=crlf
