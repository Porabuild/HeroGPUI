# HeroGPUI website — environment variables.
#
# Copy to .env.local for local overrides. Both variables are PUBLIC,
# build-time values inlined into the client bundle — no secrets belong in
# this app, and changing either one requires a rebuild (a dev-server restart
# is enough locally, a redeploy on Vercel).
#
# Vercel: set these in Project → Settings → Environment Variables (see
# DEPLOYMENT.md). Do not commit real .env files; .gitignore already excludes
# them.

# The URL path this app is mounted under.
#
#   - next.config.ts feeds it to Next's `basePath`.
#   - publicUrl() in src/components/landing/shared.tsx (and its twin in
#     src/components/catalog/component-card.tsx) prefixes public/ asset paths
#     with it.
#
#   local development:  empty        → app serves at http://localhost:3000/
#   production:         /herogpui    → https://porabuild.com/herogpui
#
# Must exactly equal the path prefix the parent zone (porabuild.com) proxies
# at — see the "Why basePath must match the mount path" section of
# DEPLOYMENT.md.
NEXT_PUBLIC_BASE_PATH=

# The absolute origin the site is served from. layout.tsx feeds it to
# `metadataBase`, which turns the site's relative canonical/Open Graph URLs
# into absolute ones.
#
#   production:     https://porabuild.com/herogpui
#   local dev:      http://localhost:3000
#
# The app falls back to the production value when unset, so this is optional
# locally — set it only if you care about OG tags in local testing.
NEXT_PUBLIC_SITE_URL=https://porabuild.com/herogpui

# Base of the compiled HeroGPUI desktop gallery (Rust/GPUI, built to
# WebAssembly), embedded live on each component page by GalleryFrame
# (src/components/preview/gallery-frame.tsx).
#
 #   - GalleryFrame appends "/index.html?story=<slug>&theme=<light|dark>"
 #     and only sets the iframe's src once the frame scrolls into view, so
 #     the wasm module is never fetched on page load alone. The explicit
 #     index.html keeps relative asset imports resolving to /gallery/ even
 #     though Next strips the trailing slash off a bare /gallery/ URL (308).
#   - A root-relative value (e.g. /gallery) is prefixed with
#     NEXT_PUBLIC_BASE_PATH, the same way public-url.ts prefixes public/
#     assets. An absolute URL (https://...) is used as-is.
#   - The compiled artifact lives in public/gallery/ (index.html +
#     herogpui_web.js + herogpui_web_bg.wasm), so the recommended value is
#     `/gallery` — same origin, which lets the embedded gallery follow the
#     site's live light/dark toggle. See DEPLOYMENT.md §6 for how the
#     artifact is rebuilt from the Rust workspace. The wasm module is a
#     plain (non-shared-memory) build, so it needs no COOP/COEP headers
#     anywhere — a /gallery rewrite in next.config.ts is the only config
#     it depends on.
#   - Unset defaults to `/gallery`, which is the checked-in same-origin
#     artifact. Set this only to host the gallery at another path or origin.
NEXT_PUBLIC_GALLERY_URL=/gallery
