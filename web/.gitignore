# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the documented template, which must ship with the checkout.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public/shots/ is tracked on purpose: the site's native screenshots, which
# remote builds (no capture rig) cannot produce. public/gallery/index.html is
# tracked too; the WebAssembly artifact beside it is not. CI builds it and
# publishes it to the `gallery-artifacts` GitHub prerelease, and
# `pnpm run build` downloads the one for this checkout (or a local
# `.shots/build-wasm.sh` build puts it here). See DEPLOYMENT.md.
/public/gallery/herogpui_web.js
/public/gallery/herogpui_web_bg.wasm
/public/gallery/build-info.json
/public/gallery/.*.download

# Session scratch: capture-polish workspace and research notes (distilled
# into HANDOFF.md / ARCHITECTURE.md instead).
.polish-tmp/
.research/
.vercel
.env*
