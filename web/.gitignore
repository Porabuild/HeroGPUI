# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the documented template, which must ship with the checkout.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public/shots/ and public/gallery/ are tracked on purpose: they are the
# site's visible content (native screenshots) and its live WebAssembly
# gallery artifact. Remote builds run `next build` alone — no Rust
# toolchain, no capture rig — so both must ship in the tree.

# Session scratch: capture-polish workspace and research notes (distilled
# into HANDOFF.md / ARCHITECTURE.md instead).
.polish-tmp/
.research/
.vercel
.env*
