+    }
+
+    #[test]
+    fn the_first_weekday_is_monday_indexed_in_both_systems() {
+        // 1 Pausha 1947 and its Gregorian equivalent are the same actual day,
+        // so they must report the same weekday whichever system asks.
+        let system = indian();
