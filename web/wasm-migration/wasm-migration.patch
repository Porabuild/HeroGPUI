+        // The result puts the right edge exactly on the inset.
+        let shift = viewport_shift(px(500.), px(220.), px(600.));
+        assert_eq!(
+            px(500.) + shift + px(220.),
+            px(600.) - OVERLAY_VIEWPORT_INSET
