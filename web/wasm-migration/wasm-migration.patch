+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// `visible_pages` is the window `page_focus` is minted from. The bound is
+    /// `2 * siblings + 5` with `siblings` fixed at 1, so a large `total` still
+    /// produces a handful of slots — the allocation the render used to spend
