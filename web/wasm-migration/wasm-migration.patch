+
+fn system_time_format() -> &'static RegionalTimeFormat {
+    static SYSTEM_TIME_FORMAT: OnceLock<RegionalTimeFormat> = OnceLock::new();
+    SYSTEM_TIME_FORMAT.get_or_init(|| {
