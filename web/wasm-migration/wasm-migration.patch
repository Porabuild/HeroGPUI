+//! Tag line boxes must match v3.2.4 even outside the gallery's 14/20 text root.
+
+mod harness;
+
+use gpui::{prelude::*, px, TestAppContext};
+use herogpui_components::{Size, Tag, TagGroup};
+
+const SELECTORS: [&str; 3] = ["tag-sm", "tag-md", "tag-lg"];
