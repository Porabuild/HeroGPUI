+                } else if *segment == TimeSegment::Meridiem {
+                    " ".to_owned()
+                } else {
+                    ":".to_owned()
+                }
+            })
+            .chain(std::iter::once(String::new()))
+            .collect();
+        Self {
+            order,
+            literals,
+            hour_has_leading_zero: !twelve_hour,
+            hour_zero_based: false,
+            minute_has_leading_zero: true,
+            second_has_leading_zero: true,
+            am: "AM".to_owned(),
+            pm: "PM".to_owned(),
