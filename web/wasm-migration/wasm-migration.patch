index 00000000..40b75cfd
--- /dev/null
+++ b/crates/herogpui-web/Cargo.toml
@@ -0,0 +1,41 @@
+[package]
+name = "herogpui-web"
+description = "HeroGPUI gallery compiled to WebAssembly for the browser"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+readme.workspace = true
+repository.workspace = true
+keywords.workspace = true
+categories.workspace = true
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[dependencies]
+gpui.workspace = true
+gpui_platform.workspace = true
+herogpui-core.workspace = true
+herogpui-theme.workspace = true
+herogpui-components = { workspace = true, features = ["gallery-source"] }
+herogpui.workspace = true
+# The gallery's pages, demo state and asset source, shared with the native
+# binary in `gallery/src/main.rs` -- this crate supplies only what a browser
+# needs instead of an environment (see `src/lib.rs`).
+herogpui-gallery.workspace = true
+
+# Web-only glue. `gpui_platform::web_init()` (called from `run`, below)
+# already installs a console panic hook and a console-backed `log` logger
+# (`gpui_web::init_logging`, at the pinned Zed revision) -- matching
+# `gpui_web`'s own `examples/hello_web`, the most authoritative reference
+# for this exact pin, which needs no separate panic-hook/logging crates
+# either. `web-sys` reads the page URL for the deep-link query string (see
+# `page_from_query`); it is a plain (not wasm-only) dependency because it
+# compiles as an inert no-op on any target, which keeps this crate part of
+# the ordinary `cargo check --workspace` gate on native.
+wasm-bindgen = "0.2.113"
+web-sys = { version = "0.3", features = ["Location", "Url", "UrlSearchParams", "Window"] }
+
+[lints]
+workspace = true
