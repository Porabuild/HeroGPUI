diff --git a/.cargo/config.toml b/.cargo/config.toml
index 7569f18..e516c92 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -3,3 +3,19 @@ linker = "rust-lld"
 
 [target.aarch64-pc-windows-msvc]
 linker = "rust-lld"
+
+# WASM build. Deliberately PLAIN -- the same override `longbridge/gpui-component`'s
+# `crates/story-web/.cargo/config.toml` makes at the pinned commit
+# (`rustflags = []`): no `+atomics`, no `--shared-memory`/`--import-memory`, no
+# `-Z build-std`. The shared-memory build that `gpui_web`'s own `hello_web`
+# example uses is only needed by its multi-threaded entry point; this crate
+# runs `single_threaded_web()`, and a shared-memory wasm would import a
+# `WebAssembly.Memory` backed by a `SharedArrayBuffer`, which browsers only
+# grant inside a cross-origin-isolated context (COOP+COEP on *every ancestor
+# document*, up to the page embedding the iframe). Longbridge ships their
+# gallery on plain GitHub Pages with no isolation headers anywhere; with this
+# config ours deploys the same way -- no per-path headers, no host-site
+# requirements. (Verified empirically: the shared-memory build sat at a 1x1
+# canvas under plain hosting; the plain build renders without any headers.)
+[target.wasm32-unknown-unknown]
+rustflags = []
