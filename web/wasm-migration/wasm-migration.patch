+    // click in the padding below the last line belongs to the last line.
+    let index = (0..usable)
+        .find(|&i| {
+            let b = paragraphs[i];
+            point.y >= b.origin.y && point.y < b.origin.y + b.size.height.max(line_height)
+        })
+        .unwrap_or_else(|| {
