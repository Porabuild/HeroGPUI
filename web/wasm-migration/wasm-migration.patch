+    /// Reduced motion removes transition timing, not the pinned press
+    /// transform. Disabled stays off the `.active` path.
+    #[test]
+    fn press_scale_is_instant_and_enabled_only() {
+        let src = source();
+        assert!(
+            src.contains(".active("),
+            "the press must be represented by GPUI's active style"
+        );
