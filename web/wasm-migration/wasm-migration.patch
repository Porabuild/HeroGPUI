+                    FieldSymbol::Minute => {
+                        minute_has_leading_zero = Some(field.length == FieldLength::Two);
+                        TimeSegment::Minute
+                    }
+                    FieldSymbol::Second(_) => {
+                        second_has_leading_zero = Some(field.length == FieldLength::Two);
