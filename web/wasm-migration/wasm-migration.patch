+        for total in [8, 50, 2000, 10_000] {
+            for page in [1, total / 2, total] {
+                let pages = visible_pages(page.max(1), total);
+                assert!(
+                    pages.len() <= cap,
+                    "page {page} of {total} showed {} slots, cap {cap}",
+                    pages.len()
