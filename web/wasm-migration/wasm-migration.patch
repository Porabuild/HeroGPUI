index a9c6adc..318dd9a 100644
--- a/rust-toolchain.toml
+++ b/rust-toolchain.toml
@@ -1,8 +1,25 @@
 # Pins the toolchain so every machine and CI resolves the same rustc: a
 # floating channel lets a Tuesday release silently invalidate every
 # incremental cache and change rustfmt's output mid-project. Bump the version
-# (and re-run the gates) deliberately. `rust-version` in Cargo.toml matches this
-# pin because the unpublished pre-1.0 workspace tracks the current stable Rust.
+# (and re-run the gates) deliberately.
+#
+# WASM migration (see WASM-MIGRATION.md): this is a dated *nightly*, not the
+# stable 1.98.0 the native build alone would need. The web target requires
+# nightly Cargo regardless of rustc version, because building a
+# shared-memory-threaded wasm32 binary needs `-Z build-std` (rebuilding `std`
+# itself with atomics enabled), which is gated to nightly Cargo — this is
+# independent of, and in addition to, whatever unstable rustc features
+# individual wasm dependencies may use. `nightly` (floating) is rejected for
+# the same reason a floating stable channel is: it would silently pick up a
+# different rustc on every machine and in CI. `f66ed399` (the pinned Zed/GPUI
+# revision, see below) is dated 2026-08-26; this nightly is dated four days
+# later, the closest available dated build at the time this was pinned, so
+# the compiler is a small, deliberate step newer than the code it builds
+# rather than older. `rust-src` is required for `-Z build-std`;
+# `wasm32-unknown-unknown` is the web build's target. Native builds and
+# `cargo test -p herogpui-components` were confirmed to still pass unchanged
+# under this nightly (same pass/fail counts as under 1.98.0 stable).
 [toolchain]
-channel = "1.98.0"
-components = ["rustfmt", "clippy"]
+channel = "nightly-2026-08-30"
+components = ["rustfmt", "clippy", "rust-src"]
+targets = ["wasm32-unknown-unknown"]
